{
  "name": "winter-gta-launcher",
  "version": "1.1.1",
  "description": "UKRAINE ONLINE launcher",
  "main": "electron/main.js",
  "author": "UKRAINE ONLINE",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always",
    "package:win": "electron-packager . \"UKRAINE ONLINE\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=src/assets/icon.ico",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:smoke": "node scripts/smoke-test.cjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.wintergta.launcher",
    "productName": "UKRAINE ONLINE",
    "artifactName": "UKRAINE-ONLINE-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "Heperxxmax",
      "repo": "WinterLauncher"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "lib/**/*",
      "config.json",
      "package.json"
    ]
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
